# Variables para Stream C (plataformas). Copiar a .env en cada host segun corresponda.
# NO commitear el .env real.

# ===== EC2-1 (warehouse) =====
# Exponer Postgres a EC2-2: setear la IP PRIVADA de EC2-1 (no 0.0.0.0).
# El acceso se restringe ademas por security group (inbound 5432 solo desde EC2-2).
POSTGRES_BIND=127.0.0.1
# Password real del warehouse (reemplazar el default 'dwh' antes de exponer 5432).
POSTGRES_PASSWORD=change-me-strong

# ----- Ingestion EC2-1 -> DataHub EC2-2 (scripts/datahub-ingest.sh) -----
WAREHOUSE_HOST_PORT=localhost:5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=dwh
WAREHOUSE_PASSWORD=change-me-strong
DATAHUB_GMS=http://EC2-2-IP-PRIVADA:8080
DATAHUB_TOKEN=

# ===== EC2-2 (Metabase + DataHub) =====
# DataHub quickstart (scripts/datahub-up.sh)
DATAHUB_VERSION=v0.14.1

# Metabase + su Postgres de metadata (infra/metabase/docker-compose.metabase.yml)
METABASE_PORT=3000
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
MB_DB_PASS=change-me-strong
