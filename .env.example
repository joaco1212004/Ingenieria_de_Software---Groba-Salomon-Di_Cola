# Copiar a .env y completar. Nunca commitear el .env real.

# API (Fase 1)
API_KEY=

# Datalake bronze (ADR-0010)
BRONZE_BUCKET=datalake-bronze

# Endpoint S3. Local con docker compose: MinIO. Produccion: dejar vacio para
# que boto3 apunte al S3 real de AWS.
S3_ENDPOINT_URL=http://minio:9000

# Credenciales. Local: root de MinIO. Produccion: credenciales temporales STS
# de AWS Academy cargadas manualmente en el .env de la EC2.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Credenciales root de MinIO del compose (solo local).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MLflow tracking + registry (ADR-0019/0022). Los clientes (Dagster training,
# API serving) solo necesitan esta URL: el server proxea los artefactos.
# Local: levantar infra/mlflow/docker-compose.mlflow.yml en el mismo host
#   (publica :5000); host.docker.internal resuelve desde los containers.
# Produccion (EC2-1): IP privada de EC2-2 (ver infra/platforms.env.example).
MLFLOW_TRACKING_URI=http://host.docker.internal:5000

# Solo si levantas el compose local de MLflow (secrets de su Postgres/MinIO).
MLFLOW_DB_PASS=change-me-local
MLFLOW_MINIO_PASS=change-me-local

# Overrides opcionales del entrenamiento (smoke runs / instancias chicas).
# ML_EPOCHS=5
# ML_MAX_WELLS=100
