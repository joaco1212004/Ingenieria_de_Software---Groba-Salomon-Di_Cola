# Copiar a .env y completar. Nunca commitear el .env real.

# ─── API (Fase 1) ────────────────────────────────────────────────────────────
API_KEY=

# ─── Datalake bronze (ADR-0010) ─────────────────────────────────────────────
# Nombre del bucket donde aterriza la capa bronze.
BRONZE_BUCKET=datalake-bronze

# Endpoint S3. Local: el MinIO del docker-compose. Producción: dejar vacío
# para que boto3 apunte al S3 real de AWS.
S3_ENDPOINT_URL=http://localhost:9000

# Credenciales. Local: las root de MinIO (minioadmin/minioadmin por defecto).
# Producción: credenciales temporales STS de AWS Academy (expiran cada ~4h).
# Renovar en EC2 con:
#   scripts/update-aws-credentials.sh -i <llave.pem> -b <bucket> -k ... -s ... -t ...
# En Windows, usar:
#   powershell -ExecutionPolicy Bypass -File .\scripts\update-aws-credentials.ps1 -PemPath <llave.pem> -Bucket <bucket>
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=        # requerido en AWS Academy; vacío en local con MinIO

# Credenciales root del servicio MinIO del compose (solo local).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
